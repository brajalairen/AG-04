# SatQuery AI configuration. Copy this file to `.env` (which is gitignored) and fill in your own values.
# Real environment variables always take precedence over this file.

# --- Copernicus Data Space Ecosystem (live Sentinel-1 / Sentinel-2 imagery for a drawn area) ---
# Required for map-area analysis. Without them the app still runs, but areas drawn on the map
# cannot fetch imagery (uploaded GeoTIFFs and the built-in demo scenarios keep working).
# Create a free account at https://dataspace.copernicus.eu, then create an OAuth client in the
# Sentinel Hub dashboard (User settings -> OAuth clients). The secret is shown only once.
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# --- Vision-language model ---
# falcon: the real remote-sensing VLM (downloaded from Hugging Face on first run, ~3.4 GB).
# fake:   deterministic placeholder answers, no download (for tests and UI development only).
SATQUERY_VLM_BACKEND=falcon
# auto (CUDA if available), cuda, or cpu.
SATQUERY_DEVICE=auto

# --- Optional settings (defaults shown; uncomment to change) ---
# SATQUERY_NUM_BEAMS=3                # beam width; 1 is faster
# SATQUERY_RUNS_DIR=runs              # where per-request reports and overlays are written
# SATQUERY_MAX_UPLOAD_MB=2048         # larger uploads are refused
# SATQUERY_FALCON_ADAPTER=            # path or Hugging Face id of a LoRA adapter for the VLM; empty = base model
# COPERNICUS_DAYS_BACK=30             # how far back the imagery search looks
# COPERNICUS_MAX_CLOUD=20             # percent; cloudier scenes are skipped
# COPERNICUS_MAX_AOI_KM2=400          # larger drawn areas are refused before any request
# SATQUERY_OPTICAL_MAX_AFFECTED=0.20  # cloud/shadow share of the area above which water questions use Sentinel-1
# SATQUERY_WEATHER=open-meteo         # open-meteo, or off to disable weather questions
# OPEN_METEO_API_KEY=                 # only for Open-Meteo's paid customer endpoint; the free API needs no key
